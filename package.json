{
    "name": "nextjs-supabase-shadcn-starter",
    "version": "1.0.0",
    "description": "Next.js + Supabase + shadcn (Base UI) Starter",
    "private": true,
    "scripts": {
        "dev": "next dev --turbo",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "check-env": "node scripts/check-env.mjs",
        "setup": "pnpm check-env && pnpm supabase:start",
        "supabase": "pnpm exec supabase",
        "supabase:login": "pnpm exec supabase login",
        "supabase:link": "pnpm exec supabase link",
        "supabase:start": "pnpm exec supabase start",
        "supabase:stop": "pnpm exec supabase stop",
        "supabase:status": "pnpm exec supabase status",
        "db:types": "pnpm exec supabase gen types typescript --local > types/database.types.ts && pnpm exec supabase-to-zod --input types/database.types.ts --output types/database.zod.ts && pnpm exec tsx scripts/patch-database-zod.ts",
        "db:reset": "pnpm exec supabase db reset && pnpm db:types && pnpm db:seed",
        "db:seed": "pnpm seed",
        "db:setup": "pnpm db:reset && pnpm seed",
        "db:migrate": "pnpm exec supabase migration new",
        "db:push": "pnpm exec supabase db push --include-all",
        "db:pull": "pnpm exec supabase db pull",
        "db:diff": "pnpm exec supabase db diff",
        "seed": "pnpm exec tsx scripts/seed/seed.ts",
        "typegen": "next typegen"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@9.15.0",
    "pnpm": {
        "onlyBuiltDependencies": [
            "core-js",
            "esbuild",
            "msw",
            "sharp",
            "supabase",
            "unrs-resolver"
        ],
        "overrides": {
            "dompurify": "^3.4.5"
        }
    },
    "dependencies": {
        "@ai-sdk/google": "^3.0.78",
        "@ai-sdk/openai": "^3.0.64",
        "@ai-sdk/react": "^3.0.191",
        "@base-ui/react": "^1.5.0",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@hookform/resolvers": "^5.2.2",
        "@supabase/ssr": "^0.10.3",
        "@supabase/supabase-js": "^2.106.1",
        "@tanstack/react-query": "^5.100.11",
        "@tanstack/react-query-devtools": "^5.100.11",
        "@tanstack/react-table": "^8.21.3",
        "@tanstack/react-virtual": "^3.13.25",
        "@tanstack/virtual-core": "^3.15.0",
        "ai": "^6.0.189",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.2.1",
        "ioredis": "^5.10.1",
        "jspdf": "^4.2.1",
        "jspdf-autotable": "^5.0.8",
        "lucide-react": "^0.577.0",
        "motion": "^12.40.0",
        "next": "16.3.0-canary.25",
        "next-safe-action": "^8.5.2",
        "next-themes": "^0.4.6",
        "nuqs": "^2.8.9",
        "pdfjs-dist": "^5.7.284",
        "react": "^19.2.6",
        "react-day-picker": "^9.13.1",
        "react-dom": "^19.2.6",
        "react-hook-form": "^7.76.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.5",
        "@tailwindcss/postcss": "^4.3.0",
        "@tanstack/eslint-plugin-query": "^5.100.11",
        "@types/node": "^25.9.1",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "dotenv": "^17.4.2",
        "eslint": "^9.39.2",
        "eslint-config-next": "16.3.0-canary.25",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-unused-imports": "^4.4.1",
        "postcss": "^8.5.15",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "shadcn": "^3.8.4",
        "supabase": "^2.101.0",
        "supabase-to-zod": "^1.0.7",
        "tailwindcss": "^4.3.0",
        "tw-animate-css": "^1.4.0",
        "tsx": "^4.22.3",
        "typescript": "^5.9.3"
    }
}
