{
    "name": "nextjs-supabase-shadcn-starter",
    "version": "1.0.0",
    "description": "nextjs-supabase-shadcn-starter System mit KI und OCR",
    "private": true,
    "scripts": {
        "dev": "next dev --turbo",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "check-env": "node scripts/check-env.js",
        "setup": "node scripts/check-env.js && npm run supabase:start",
        "supabase": "npx supabase",
        "supabase:login": "npx supabase login",
        "supabase:link": "npx supabase link",
        "supabase:start": "npx supabase start",
        "supabase:stop": "npx supabase stop",
        "supabase:status": "npx supabase status",
        "db:types": "npx supabase gen types typescript --local > types/database.types.ts && npx supabase-to-zod --input types/database.types.ts --output types/database.zod.ts && npx tsx scripts/patch-database-zod.ts",
        "db:reset": "npx supabase db reset && npm run db:types && npm run db:seed",
        "db:seed": "npm run seed",
        "db:setup": "npm run db:reset && npm run seed",
        "db:migrate": "npx supabase migration new",
        "db:push": "npx supabase db push --include-all",
        "db:pull": "npx supabase db pull",
        "db:diff": "npx supabase db diff",
        "seed": "npx tsx scripts/seed/seed.ts",
        "typegen": "next typegen"
    },
    "engines": {
        "node": "24.x"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "core-js",
            "esbuild",
            "msw",
            "sharp",
            "supabase",
            "unrs-resolver"
        ]
    },
    "dependencies": {
        "@ai-sdk/google": "^3.0.23",
        "@ai-sdk/openai": "^3.0.26",
        "@ai-sdk/react": "^3.0.80",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@hookform/resolvers": "^5.2.2",
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-alert-dialog": "^1.1.15",
        "@radix-ui/react-avatar": "^1.1.11",
        "@radix-ui/react-checkbox": "^1.3.3",
        "@radix-ui/react-collapsible": "^1.1.12",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-hover-card": "^1.1.15",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-progress": "^1.1.8",
        "@radix-ui/react-radio-group": "^1.3.8",
        "@radix-ui/react-scroll-area": "^1.2.10",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.2.6",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@supabase/ssr": "^0.9.0",
        "@supabase/supabase-js": "^2.95.3",
        "@tanstack/react-query": "^5.90.20",
        "@tanstack/react-query-devtools": "^5.91.3",
        "@tanstack/react-table": "^8.21.3",
        "@tanstack/react-virtual": "^3.13.18",
        "@tanstack/virtual-core": "^3.13.18",
        "ai": "^6.0.78",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.1.0",
        "ioredis": "^5.10.0",
        "jspdf": "^4.0.0",
        "jspdf-autotable": "^5.0.7",
        "lucide-react": "^0.577.0",
        "motion": "^12.34.0",
        "next": "^16.1.1-canary.12",
        "next-safe-action": "^8.0.11",
        "next-themes": "^0.4.6",
        "nuqs": "^2.8.8",
        "pdfjs-dist": "^5.4.624",
        "react": "^19.2.4",
        "react-day-picker": "^9.13.1",
        "react-dom": "^19.2.4",
        "react-hook-form": "^7.71.1",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.4.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.3",
        "@tailwindcss/postcss": "^4.1.18",
        "@tanstack/eslint-plugin-query": "^5.91.4",
        "@types/node": "^25.2.2",
        "@types/react": "^19.2.13",
        "@types/react-dom": "^19.2.3",
        "dotenv": "^17.2.4",
        "eslint": "^9.39.2",
        "eslint-config-next": "^16.2.0-canary.32",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-unused-imports": "^4.4.1",
        "postcss": "^8.4.49",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "shadcn": "^3.8.4",
        "supabase": "^2.76.5",
        "supabase-to-zod": "^1.0.7",
        "tailwindcss": "^4.1.18",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2"
    }
}

